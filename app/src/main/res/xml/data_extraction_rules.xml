<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The draw history can always be downloaded again, keep backups small. -->
        <exclude domain="file" path="history_lapr.csv" />
        <exclude domain="file" path="history_emil.csv" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="history_lapr.csv" />
        <exclude domain="file" path="history_emil.csv" />
    </device-transfer>
</data-extraction-rules>
